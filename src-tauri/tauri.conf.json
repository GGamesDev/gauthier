{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gauthier",
  "version": "0.1.0",
  "identifier": "dev.gauthier.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gauthier",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/picorust-runtime": "picorust-runtime" },
    "category": "DeveloperTool",
    "shortDescription": "A simple Rust IDE for beginners and the Raspberry Pi Pico"
  }
}
